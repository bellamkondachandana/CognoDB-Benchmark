# Never commit .env
# CognoDB Cloud
COGNODB_URI=bolt+s://YOUR-INSTANCE.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Neo4j Aura / other Bolt endpoint
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Memgraph Cloud / self-hosted
MEMGRAPH_URI=
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# FalkorDB
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ArangoDB
ARANGO_URL=
ARANGO_USER=
ARANGO_PASSWORD=
ARANGO_DB=benchmark
